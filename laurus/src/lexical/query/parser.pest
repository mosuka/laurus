// Query Grammar for Pest Parser
// This grammar supports the full query syntax

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Main entry point
query = { SOI ~ boolean_query ~ EOI }

// Boolean query with AND/OR operators (space-separated clauses default to implicit boolean)
boolean_query = { clause ~ (boolean_op ~ clause | clause)* }

clause = { required_clause | prohibited_clause | sub_clause }

// `NOT` prohibits the clause after it, as `-` does (issue #1747). With no
// clause after it, `NOT` is a term, as a trailing `AND` or `OR` is.
required_clause = { "+" ~ sub_clause }
prohibited_clause = { ("-" | not_op) ~ sub_clause }

sub_clause = { grouped_query | field_query | term_query }

grouped_query = { "(" ~ boolean_query ~ ")" ~ boost? }

// The keywords are operators only in capitals and as whole words (issue
// #1747), as in Lucene's classic query parser and Tantivy: `and`, `Not`,
// `ANDROID` and `NOTE` are terms. The rules are atomic, so no implicit
// whitespace comes between a keyword and the lookahead after it.
boolean_op = @{ ("AND" | "OR") ~ !keyword_tail }
not_op = @{ "NOT" ~ !keyword_tail }

// A character that continues a term, a field name (`AND:x` is the field
// `AND`), an escape, a wildcard, a fuzzy term or a boost after a keyword.
// `(`, `"` and whitespace end it: `NOT(a b)` and `NOT"a b"` prohibit.
keyword_tail = _{ LETTER | NUMBER | "_" | "-" | "'" | "." | ":" | "\\" | "*" | "?" | "~" | "^" }

// Field-specific queries
field_query = { field ~ ":" ~ field_value }

field_value = { geo3d_query | geo_query | range_query | phrase_query | fuzzy_term | wildcard_term | simple_term }

// 3D geo queries (ECEF Cartesian coordinates, meters):
//   field:geo3d_distance(x, y, z, distance_m)
//   field:geo3d_bbox(min_x, min_y, min_z, max_x, max_y, max_z)
//   field:geo3d_nearest(x, y, z, k)
//   field:geo3d_polyline((x, y, z, x, y, z, ...), distance_m)
// A polyline's vertices are joined in order by straight segments (issue
// #1596).
geo3d_query = { geo3d_distance | geo3d_bbox | geo3d_nearest | geo3d_polyline }
geo3d_polyline = { ^"geo3d_polyline" ~ "(" ~ geo_vertices ~ "," ~ signed_float ~ ")" }
geo3d_distance = {
    ^"geo3d_distance" ~ "(" ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ ")"
}
geo3d_bbox = {
    ^"geo3d_bbox" ~ "(" ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ ")"
}
geo3d_nearest = {
    ^"geo3d_nearest" ~ "(" ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ unsigned_int ~ ")"
}

// 2D geo queries (latitude / longitude in degrees, distance in metres):
//   field:geo_distance(lat, lon, distance_m)
//   field:geo_bbox(min_lat, min_lon, max_lat, max_lon)
//   field:geo_polygon((lat, lon, lat, lon, ...), (lat, lon, ...), ...)
//   field:geo_polyline((lat, lon, lat, lon, ...), distance_m)
// A polygon's first ring is the exterior and the others are holes, each a
// list of latitude and longitude pairs; a polyline's vertices are joined in
// order by great-circle arcs (issue #1596).
geo_query = { geo_distance | geo_bbox | geo_polygon | geo_polyline }
geo_polygon = { ^"geo_polygon" ~ "(" ~ geo_vertices ~ ("," ~ geo_vertices)* ~ ")" }
geo_polyline = { ^"geo_polyline" ~ "(" ~ geo_vertices ~ "," ~ signed_float ~ ")" }
// The coordinates of vertices, in parentheses: of a ring of `geo_polygon`,
// or of `geo_polyline` and `geo3d_polyline`.
geo_vertices = { "(" ~ signed_float ~ ("," ~ signed_float)* ~ ")" }
geo_distance = {
    ^"geo_distance" ~ "(" ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ ")"
}
geo_bbox = {
    ^"geo_bbox" ~ "(" ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ "," ~ signed_float ~ ")"
}

signed_float = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
unsigned_int = @{ ASCII_DIGIT+ }

// Range queries: [100 TO 500] or {A TO Z}
range_query = { range_inclusive | range_exclusive }
range_inclusive = { "[" ~ range_value ~ ^"TO" ~ range_value ~ "]" }
range_exclusive = { "{" ~ range_value ~ ^"TO" ~ range_value ~ "}" }
range_value = { "*" | quoted_string | unquoted_value }
unquoted_value = @{ (!WHITESPACE ~ !"TO" ~ !"]" ~ !"}" ~ ANY)+ }

// Phrase queries: "hello world" or "hello world"~10
// A backslash takes the next character literally, whatever it is, so `\"`
// does not end the phrase (issue #1758), as in Lucene's `QUOTED`; the parser
// drops the backslashes before the analysis. A quoted range bound and a
// quoted vector value read the same way.
phrase_query = { "\"" ~ phrase_content ~ "\"" ~ proximity? ~ boost? }
phrase_content = @{ ("\\" ~ ANY | !"\"" ~ ANY)* }
proximity = { "~" ~ number }

// Fuzzy queries: term~2
fuzzy_term = { term ~ "~" ~ fuzziness? ~ boost? }
fuzziness = { number }

// Wildcard queries: te?t or test*
// A wildcard takes the characters of a term (`escaped_char`: Unicode
// letters and numbers, `_`, `-`, `'` and a backslash before a special
// character) and `?` and `*`, as Lucene's `WILDTERM` does (issue #1745), so
// `a-b*`, `it's*` and `te\*t*` are one wildcard each, and so is `foo*-bar`.
// The pattern goes to `WildcardQuery` as written, which reads the escapes.
// It used to take letters, numbers and `_` only, and end before any other
// character, leaving a bare `*` as a clause of its own.
wildcard_term = { wildcard_pattern ~ boost? }
wildcard_pattern = @{
    escaped_char* ~ wildcard_char ~ (escaped_char | wildcard_char)*
}
wildcard_char = { "?" | "*" }

// Simple term with optional boost
simple_term = { term ~ boost? }

// Term query (standalone, no field)
term_query = { field_value }

// Boost: ^4 or ^0.5
boost = { "^" ~ boost_value }
boost_value = @{ number ~ ("." ~ number)? }

// Field name (ASCII-only on purpose; field identifiers stay portable)
field = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | ".")* }

// Term (word)
// `LETTER | NUMBER` is Unicode-aware (Letter / Number general categories),
// so CJK / Cyrillic / Greek / accented Latin etc. all parse as bare
// terms without requiring quoting. `boolean_op` keywords (AND / OR)
// remain whitespace-bounded as before.
// `'` is allowed unescaped (issue #1111): it has no syntactic meaning in
// the DSL, unlike `+`/`-`/`:`/`"` etc., and is extremely common in
// ordinary English text (contractions like `it's`/`don't`, possessives
// like `user's`). Added to both `unescaped_term` and `normal_char` — the
// latter is what `escaped_char+` (tried before `unescaped_term` below)
// actually consumes a bare, non-backslashed character with, so omitting
// it there would truncate `it's` to `it` before the apostrophe was ever
// reached.
term = @{ escaped_char+ | unescaped_term }
unescaped_term = @{ (LETTER | NUMBER | "_" | "-" | "'")+ }
escaped_char = @{ "\\" ~ special_char | normal_char }
special_char = { "+" | "-" | "!" | "(" | ")" | "{" | "}" | "[" | "]" | "^" | "\"" | "~" | "*" | "?" | ":" | "\\" | "/" }
normal_char = @{ LETTER | NUMBER | "_" | "-" | "'" }

// Quoted string (a range bound), with the escapes of a phrase (issue #1758),
// as in Lucene's `RANGE_QUOTED`
quoted_string = { "\"" ~ quoted_content ~ "\"" }
quoted_content = @{ ("\\" ~ ANY | !"\"" ~ ANY)* }

// Number
number = @{ ASCII_DIGIT+ }
